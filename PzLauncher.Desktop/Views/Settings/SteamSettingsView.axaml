<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Settings"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="PzLauncher.Desktop.Views.Settings.SteamSettingsView"
             x:DataType="vm:SteamSettingsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.SteamSettings" />
    </Design.DataContext>

    <StackPanel Margin="24,16" Spacing="12">
        <TextBlock Text="{x:Static lang:UiText.Settings_Steam}" Classes="pageTitle" />
        <TextBlock Text="{Binding AccountText}" IsVisible="{Binding AccountText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ToggleSwitch Content="{x:Static lang:UiText.Steam_Hook}" OnContent="{x:Null}" OffContent="{x:Null}"
                      IsChecked="{Binding IsHookOn}" IsEnabled="{Binding CanToggle}" />
        <TextBlock Text="{x:Static lang:UiText.Steam_HookHint}" Classes="hint" />
        <TextBlock Text="{Binding OtherLauncherText}" TextWrapping="Wrap"
                   IsVisible="{Binding OtherLauncherText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ProgressBar IsIndeterminate="True" Width="480" HorizontalAlignment="Left" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes.error="{Binding IsStatusError}"
                   IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Text="{x:Static lang:UiText.Steam_LaunchOptionsHint}" Classes="hint" />
        <CheckBox Content="{x:Static lang:UiText.Steam_RemindAtStartup}" IsChecked="{Binding RemindAtStartup}" />
    </StackPanel>
</UserControl>
