<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Settings"
             xmlns:themes="using:PzLauncher.Desktop.Themes"
             xmlns:launch="using:PzLauncher.Desktop.Services.Launch"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:controls="using:PzLauncher.Desktop.Views.Controls"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:settings="using:PzLauncher.Desktop.Views.Settings"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="PzLauncher.Desktop.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.Settings" />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="sidebar left" MinWidth="180">
            <StackPanel Margin="8" Spacing="2">
                <TextBlock Classes="sidebarHeader" Text="{x:Static lang:UiText.Settings_LauncherGroup}" />
                <controls:NavItem Icon="Options" Content="{x:Static lang:UiText.Settings_General}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.General}}" />
                <controls:NavItem Icon="PaintBrush" Content="{x:Static lang:UiText.Settings_Appearance}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Appearance}}" />
                <controls:NavItem Icon="ArrowSync" Content="{x:Static lang:UiText.Settings_Updates}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Updates}}" />
                <controls:NavItem Icon="Globe" Content="{x:Static lang:UiText.Settings_Proxy}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Proxy}}" />
                <TextBlock Classes="sidebarHeader" Text="{x:Static lang:UiText.Settings_GameGroup}" />
                <controls:NavItem Icon="DrinkCoffee" Content="{x:Static lang:UiText.Settings_Java}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Java}}" />
                <controls:NavItem Icon="Games" Content="{x:Static lang:UiText.Settings_Steam}" IsVisible="{Binding Steam.IsSupported}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Steam}}" />
            </StackPanel>
        </Border>

        <Panel Grid.Column="1" Background="{DynamicResource Shell.ContentBackground}">
            <!-- No option is checked while nothing is saved: the first launch still asks. -->
            <StackPanel Margin="24,16" Spacing="12"
                        IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.General}}">
                <TextBlock Text="{x:Static lang:UiText.Settings_General}" Classes="pageTitle" />
                <TextBlock Text="{x:Static lang:UiText.Settings_AfterLaunch}" Classes="sectionTitle" />
                <StackPanel Spacing="4">
                    <RadioButton Content="{x:Static lang:UiText.AfterLaunchAction_Keep}"
                                 IsChecked="{Binding AfterLaunch.Action, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static launch:AfterLaunchAction.Keep}}" />
                    <RadioButton Content="{x:Static lang:UiText.AfterLaunchAction_Minimize}"
                                 IsChecked="{Binding AfterLaunch.Action, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static launch:AfterLaunchAction.Minimize}}" />
                    <RadioButton Content="{x:Static lang:UiText.AfterLaunchAction_MinimizeToTray}"
                                 IsChecked="{Binding AfterLaunch.Action, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static launch:AfterLaunchAction.MinimizeToTray}}" />
                    <RadioButton Content="{x:Static lang:UiText.AfterLaunchAction_Close}"
                                 IsChecked="{Binding AfterLaunch.Action, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static launch:AfterLaunchAction.Close}}" />
                </StackPanel>
                <TextBlock Text="{x:Static lang:UiText.Settings_AfterLaunchHint}" Classes="hint" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="24,16" Spacing="12"
                        IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Appearance}}">
                <TextBlock Text="{x:Static lang:UiText.Settings_Appearance}" Classes="pageTitle" />
                <TextBlock Text="{x:Static lang:UiText.Settings_Theme}" Classes="sectionTitle" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <RadioButton Content="{x:Static lang:UiText.Settings_ThemeLight}"
                                 IsChecked="{Binding Theme, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static themes:AppTheme.Light}}" />
                    <RadioButton Content="{x:Static lang:UiText.Settings_ThemeDark}"
                                 IsChecked="{Binding Theme, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static themes:AppTheme.Dark}}" />
                </StackPanel>
                <TextBlock Text="{x:Static lang:UiText.Settings_Window}" Classes="sectionTitle" />
                <Button Content="{x:Static lang:UiText.Settings_ResetWindowSize}" Command="{Binding ResetWindowSizeCommand}" />
            </StackPanel>
            <!-- Wrapped: each section view's own DataContext is its view model, so it can't bind Section itself. -->
            <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Updates}}">
                <settings:UpdateSettingsView DataContext="{Binding Updates}" />
            </Panel>
            <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Proxy}}">
                <settings:ProxySettingsView DataContext="{Binding Proxy}" />
            </Panel>
            <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Java}}">
                <settings:JavaSettingsView DataContext="{Binding Java}" />
            </Panel>
            <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Steam}}">
                <settings:SteamSettingsView DataContext="{Binding Steam}" />
            </Panel>
        </Panel>
    </Grid>
</UserControl>
