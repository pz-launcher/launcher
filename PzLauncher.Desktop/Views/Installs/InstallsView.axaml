<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Installs"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:installs="using:PzLauncher.Core.Installs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PzLauncher.Desktop.Views.Installs.InstallsView"
             x:DataType="vm:InstallsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.Installs" />
    </Design.DataContext>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Installs" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Rescan" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Add folder…" Command="{Binding AddFolderCommand}" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsScanning}" Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Foreground="#C62828" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Foreground="#B26A00" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Panel>
            <TextBlock Text="No Project Zomboid installs found. Install the game or the dedicated server through Steam, or use &quot;Add folder…&quot;."
                       IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

            <ListBox ItemsSource="{Binding Installs}" IsVisible="{Binding !IsEmpty}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="installs:PzInstall">
                        <StackPanel Spacing="2" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Source}" Opacity="0.7" />
                                <!-- Content null (manual install) renders nothing, so the inner bindings never see a null Steam. -->
                                <ContentControl Content="{Binding Steam}"
                                                IsVisible="{Binding Steam, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="installs:SteamAppInfo">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Branch, StringFormat='branch: {0}'}" Opacity="0.7"
                                                           IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Text="{Binding BuildId, StringFormat='build {0}'}" Opacity="0.7" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                            <TextBlock Text="{Binding RootPath}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</UserControl>
