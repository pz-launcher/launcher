<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Installs"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:installs="using:PzLauncher.Core.Installs"
             xmlns:controls="using:PzLauncher.Desktop.Views.Controls"
             xmlns:loc="using:PzLauncher.Desktop.Localization"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="PzLauncher.Desktop.Views.Installs.InstallsView"
             x:DataType="vm:InstallsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.Installs" />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="sidebar left" MinWidth="180">
            <StackPanel Margin="8" Spacing="2">
                <TextBlock Classes="sidebarHeader" Text="{x:Static lang:UiText.Installs_FilterKindGroup}" />
                <controls:NavItem Icon="Games" Content="{x:Static lang:UiText.InstallKind_Game}"
                                  IsChecked="{Binding Filter, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:InstallsFilter.Game}}" />
                <controls:NavItem Icon="Server" Content="{x:Static lang:UiText.InstallKind_DedicatedServer}"
                                  IsChecked="{Binding Filter, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:InstallsFilter.DedicatedServer}}" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1" Background="{DynamicResource Shell.ContentBackground}">
            <DockPanel Margin="16">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Installs_Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Static lang:UiText.Installs_Rescan}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="{x:Static lang:UiText.Installs_AddFolder}" Command="{Binding AddFolderCommand}" />
                </Grid>

                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsScanning}" Margin="0,0,0,8" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Foreground="{DynamicResource Shell.ErrorForeground}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Shell.WarningForeground}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Panel>
                    <TextBlock Text="{x:Static lang:UiText.Installs_Empty}"
                               IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Opacity="0.7"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{x:Static lang:UiText.Installs_FilterEmpty}"
                               IsVisible="{Binding IsFilterEmpty}" TextWrapping="Wrap" Opacity="0.7"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                    <!-- Rows are buttons, not ListBox items: a click uses the install and goes Home. The settings button is a sibling so the two never nest. -->
                    <ScrollViewer IsVisible="{Binding !IsEmpty}">
                        <ItemsControl ItemsSource="{Binding VisibleInstalls}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstallRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Button Grid.Column="0" Theme="{StaticResource Shell.ListRow}" Classes.inUse="{Binding IsInUse}"
                                                Command="{Binding $parent[ItemsControl].((vm:InstallsViewModel)DataContext).ChooseCommand}"
                                                CommandParameter="{Binding Install}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Install.Kind, Converter={x:Static loc:DisplayNames.InstallKind}}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Install.Source, Converter={x:Static loc:DisplayNames.InstallSource}}" Opacity="0.7" />
                                                        <!-- Content null (manual install) renders nothing, so the inner bindings never see a null Steam. -->
                                                        <ContentControl Content="{Binding Install.Steam}"
                                                                        IsVisible="{Binding Install.Steam, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="installs:SteamAppInfo">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding Branch, StringFormat={x:Static lang:UiText.Installs_BranchFormat}}" Opacity="0.7"
                                                                                   IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                        <TextBlock Text="{Binding BuildId, StringFormat={x:Static lang:UiText.Installs_BuildFormat}}" Opacity="0.7" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Install.RootPath}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Static lang:UiText.Installs_InUse}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Shell.SidebarItemSelectedForeground}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsInUse}" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Command="{Binding $parent[ItemsControl].((vm:InstallsViewModel)DataContext).OpenSettingsCommand}"
                                                CommandParameter="{Binding Install}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ic:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Static lang:UiText.Home_LaunchSettings}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
