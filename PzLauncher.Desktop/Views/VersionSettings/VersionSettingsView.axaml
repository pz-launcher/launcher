<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.VersionSettings"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:controls="using:PzLauncher.Desktop.Views.Controls"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="PzLauncher.Desktop.Views.VersionSettings.VersionSettingsView"
             x:DataType="vm:VersionSettingsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.VersionSettings" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Shell.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.missing">
            <Setter Property="Foreground" Value="{DynamicResource Shell.ErrorForeground}" />
        </Style>
        <Style Selector="Slider.memory">
            <Setter Property="TickFrequency" Value="{x:Static vm:VersionSettingsViewModel.MemoryStep}" />
            <Setter Property="SmallChange" Value="{x:Static vm:VersionSettingsViewModel.MemoryStep}" />
            <Setter Property="LargeChange" Value="{x:Static vm:VersionSettingsViewModel.MemoryStep}" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource Shell.ContentBackground}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="24,16,24,0">
            <Button Grid.Column="0" Command="{Binding BackCommand}" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip.Tip="{x:Static lang:UiText.VersionSettings_Back}"
                    AutomationProperties.Name="{x:Static lang:UiText.VersionSettings_Back}">
                <ic:FluentIcon Icon="ArrowLeft" IconVariant="Regular" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Static lang:UiText.VersionSettings_Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Install.RootPath}" Classes="hint" />
            </StackPanel>
        </Grid>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="24,12,24,0" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Foreground="{DynamicResource Shell.ErrorForeground}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="24,12,24,0" />

        <ScrollViewer IsVisible="{Binding HasSettings}">
            <StackPanel Margin="24,12,24,24" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Shell.WarningForeground}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="16" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static lang:UiText.VersionSettings_LaunchSection}" FontSize="16" FontWeight="SemiBold" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.VersionSettings_Java}" />
                        <ComboBox ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding JavaSelection}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:JavaOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" Classes.missing="{Binding IsMissing}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PathText}" Classes="hint" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding PathText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding BundledJavaMajor, StringFormat={x:Static lang:UiText.VersionSettings_JavaVersionWarning}}"
                                   Foreground="{DynamicResource Shell.WarningForeground}" TextWrapping="Wrap"
                                   IsVisible="{Binding ShowJavaVersionWarning}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.VersionSettings_Memory}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton IsChecked="{Binding MaxMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.FollowJson}}">
                                <Panel>
                                    <TextBlock Text="{Binding JsonMaxMemoryMb, StringFormat={x:Static lang:UiText.VersionSettings_MemoryFollowJson}}"
                                               IsVisible="{Binding JsonMaxMemoryMb, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{x:Static lang:UiText.VersionSettings_MemoryNotSet}"
                                               IsVisible="{Binding JsonMaxMemoryMb, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </RadioButton>
                            <RadioButton Content="{x:Static lang:UiText.VersionSettings_MemoryCustom}"
                                         IsChecked="{Binding MaxMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MaxMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}">
                            <!-- Both sliders bind Minimum and Maximum before Value: the other way round, the slider clamps the
                                 value into its default 0..100 range when the view binds and writes that back to the saved setting. -->
                            <Slider Grid.Column="0" Classes="memory"
                                    Minimum="{Binding MaxMemorySliderMinimum}" Maximum="{Binding MaxMemorySliderMaximum}"
                                    Value="{Binding CustomMaxMemoryMb}" />
                            <TextBlock Grid.Column="1" Text="{Binding CustomMaxMemoryGb, StringFormat={x:Static lang:UiText.VersionSettings_MemoryValue}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />
                        </Grid>
                        <TextBlock Classes="hint" Text="{Binding SystemMemoryGb, StringFormat={x:Static lang:UiText.VersionSettings_SystemMemory}}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.VersionSettings_MinMemory}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton IsChecked="{Binding MinMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.FollowJson}}">
                                <Panel>
                                    <TextBlock Text="{Binding JsonMinMemoryMb, StringFormat={x:Static lang:UiText.VersionSettings_MemoryFollowJson}}"
                                               IsVisible="{Binding JsonMinMemoryMb, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{x:Static lang:UiText.VersionSettings_MemoryNotSet}"
                                               IsVisible="{Binding JsonMinMemoryMb, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </RadioButton>
                            <RadioButton Content="{x:Static lang:UiText.VersionSettings_MemoryCustom}"
                                         IsChecked="{Binding MinMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MinMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}">
                            <Slider Grid.Column="0" Classes="memory"
                                    Minimum="{Binding MinMemorySliderMinimum}" Maximum="{Binding MinMemorySliderMaximum}"
                                    Value="{Binding CustomMinMemoryMb}" />
                            <TextBlock Grid.Column="1" Text="{Binding CustomMinMemoryGb, StringFormat={x:Static lang:UiText.VersionSettings_MemoryValue}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.VersionSettings_JvmArgs}" />
                        <TextBox Text="{Binding ExtraJvmArgs}" AcceptsReturn="False" />
                        <StackPanel Spacing="2" IsVisible="{Binding JsonVmArgs, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="hint" Text="{x:Static lang:UiText.VersionSettings_JsonVmArgs}" />
                            <SelectableTextBlock Text="{Binding JsonVmArgs}" FontSize="12" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource Shell.TextMuted}" />
                        </StackPanel>

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.VersionSettings_GameArgs}" />
                        <TextBox Text="{Binding ExtraGameArgs}" AcceptsReturn="False" />
                        <TextBlock Classes="hint" Text="{x:Static lang:UiText.VersionSettings_ArgsHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
