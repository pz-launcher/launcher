<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Home"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:installs="using:PzLauncher.Core.Installs"
             xmlns:loc="using:PzLauncher.Desktop.Localization"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="PzLauncher.Desktop.Views.Home.HomeView"
             x:DataType="vm:HomeViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.Home" />
    </Design.DataContext>

    <Grid ColumnDefinitions="*,Auto">
        <Border Grid.Column="0" Background="{DynamicResource Shell.ContentBackground}" />

        <Border Grid.Column="1" Classes="sidebar right" MinWidth="280" MaxWidth="360">
            <DockPanel Margin="20,24">
                <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                    <Button Classes="accent" Command="{Binding LaunchCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:FluentIcon Icon="Play" IconVariant="Regular" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:UiText.Home_Launch}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectVersionCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="AppsList" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:UiText.Home_SelectVersion}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Panel VerticalAlignment="Center" Margin="0,0,0,24">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
                    <TextBlock Text="{x:Static lang:UiText.Home_NoInstall}" IsVisible="{Binding IsEmpty}"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Shell.TextMuted}" />

                    <!-- Content null renders nothing, so the inner bindings never see a null install. -->
                    <ContentControl Content="{Binding SelectedInstall}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="installs:PzInstall">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Static lang:UiText.Home_CurrentInstall}" FontSize="12"
                                               Foreground="{DynamicResource Shell.TextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Kind, Converter={x:Static loc:DisplayNames.InstallKind}}"
                                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <ContentControl Content="{Binding Steam}" HorizontalAlignment="Center"
                                                    IsVisible="{Binding Steam, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="installs:SteamAppInfo">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Branch, StringFormat={x:Static lang:UiText.Installs_BranchFormat}}"
                                                               Foreground="{DynamicResource Shell.TextMuted}"
                                                               IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <TextBlock Text="{Binding BuildId, StringFormat={x:Static lang:UiText.Installs_BuildFormat}}"
                                                               Foreground="{DynamicResource Shell.TextMuted}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <TextBlock Text="{Binding RootPath}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource Shell.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Panel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
