<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.LaunchSettings"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:controls="using:PzLauncher.Desktop.Views.Controls"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:loc="using:PzLauncher.Desktop.Localization"
             xmlns:zb="using:PzLauncher.Core.Mod.ZombieBuddy"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="PzLauncher.Desktop.Views.LaunchSettings.LaunchSettingsView"
             x:DataType="vm:LaunchSettingsViewModel"
             controls:PageActivation.Command="{Binding ActivateCommand}">

    <Design.DataContext>
        <x:Static Member="design:DesignData.LaunchSettings" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Slider.memory">
            <Setter Property="TickFrequency" Value="{x:Static vm:LaunchSettingsViewModel.MemoryStep}" />
            <Setter Property="SmallChange" Value="{x:Static vm:LaunchSettingsViewModel.MemoryStep}" />
            <Setter Property="LargeChange" Value="{x:Static vm:LaunchSettingsViewModel.MemoryStep}" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource Shell.ContentBackground}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="24,16,24,0">
            <Button Grid.Column="0" Command="{Binding BackCommand}" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip.Tip="{x:Static lang:UiText.LaunchSettings_Back}"
                    AutomationProperties.Name="{x:Static lang:UiText.LaunchSettings_Back}">
                <ic:FluentIcon Icon="ArrowLeft" IconVariant="Regular" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Static lang:UiText.LaunchSettings_Title}" Classes="pageTitle" />
                <TextBlock Text="{Binding Install.RootPath}" Classes="hint" />
            </StackPanel>
            <Button Grid.Column="2" Classes="accent" Command="{Binding UseCommand}" VerticalAlignment="Center"
                    Margin="12,0,0,0" Padding="20,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static lang:UiText.LaunchSettings_Use}" FontWeight="SemiBold" VerticalAlignment="Center"
                               IsVisible="{Binding !IsInUse}" />
                    <TextBlock Text="{x:Static lang:UiText.Installs_InUse}" FontWeight="SemiBold" VerticalAlignment="Center"
                               IsVisible="{Binding IsInUse}" />
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="24,12,24,0" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="24,12,24,0" />

        <ScrollViewer IsVisible="{Binding HasSettings}">
            <StackPanel Margin="24,12,24,24" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="warning" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="16" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static lang:UiText.LaunchSettings_LaunchSection}" Classes="sectionTitle" />
                        <TextBlock Text="{Binding LaunchProblemText}" Classes="error" TextWrapping="Wrap"
                                   IsVisible="{Binding LaunchProblemText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.LaunchSettings_Java}" />
                        <ComboBox ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding JavaSelection}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:JavaOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" Classes.error="{Binding IsMissing}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PathText}" Classes="hint" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding PathText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding BundledJavaMajor, StringFormat={x:Static lang:UiText.LaunchSettings_JavaVersionWarning}}"
                                   Classes="warning" TextWrapping="Wrap"
                                   IsVisible="{Binding ShowJavaVersionWarning}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.LaunchSettings_Gc}" />
                        <ComboBox ItemsSource="{Binding GcOptions}" SelectedItem="{Binding GcSelection}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GcOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding GcProblemText}" Classes="error" TextWrapping="Wrap"
                                   IsVisible="{Binding GcProblemText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.LaunchSettings_Memory}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton IsChecked="{Binding MaxMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.FollowJson}}">
                                <Panel>
                                    <TextBlock Text="{Binding JsonMaxMemoryMb, StringFormat={x:Static lang:UiText.LaunchSettings_MemoryFollowJson}}"
                                               IsVisible="{Binding JsonMaxMemoryMb, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{x:Static lang:UiText.LaunchSettings_MemoryNotSet}"
                                               IsVisible="{Binding JsonMaxMemoryMb, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </RadioButton>
                            <RadioButton Content="{x:Static lang:UiText.LaunchSettings_MemoryCustom}"
                                         IsChecked="{Binding MaxMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MaxMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}">
                            <!-- Both sliders bind Minimum and Maximum before Value: the other way round, the slider clamps the
                                 value into its default 0..100 range when the view binds and writes that back to the saved setting. -->
                            <Slider Grid.Column="0" Classes="memory"
                                    Minimum="{Binding MaxMemorySliderMinimum}" Maximum="{Binding MaxMemorySliderMaximum}"
                                    Value="{Binding CustomMaxMemoryMb}" />
                            <TextBlock Grid.Column="1" Text="{Binding CustomMaxMemoryGb, StringFormat={x:Static lang:UiText.LaunchSettings_MemoryValue}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />
                        </Grid>
                        <TextBlock Classes="hint" Text="{Binding SystemMemoryGb, StringFormat={x:Static lang:UiText.LaunchSettings_SystemMemory}}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.LaunchSettings_MinMemory}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton IsChecked="{Binding MinMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.FollowJson}}">
                                <Panel>
                                    <TextBlock Text="{Binding JsonMinMemoryMb, StringFormat={x:Static lang:UiText.LaunchSettings_MemoryFollowJson}}"
                                               IsVisible="{Binding JsonMinMemoryMb, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{x:Static lang:UiText.LaunchSettings_MemoryNotSet}"
                                               IsVisible="{Binding JsonMinMemoryMb, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </RadioButton>
                            <RadioButton Content="{x:Static lang:UiText.LaunchSettings_MemoryCustom}"
                                         IsChecked="{Binding MinMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MinMemoryMode, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:MemoryMode.Custom}}">
                            <Slider Grid.Column="0" Classes="memory"
                                    Minimum="{Binding MinMemorySliderMinimum}" Maximum="{Binding MinMemorySliderMaximum}"
                                    Value="{Binding CustomMinMemoryMb}" />
                            <TextBlock Grid.Column="1" Text="{Binding CustomMinMemoryGb, StringFormat={x:Static lang:UiText.LaunchSettings_MemoryValue}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.LaunchSettings_JvmArgs}" />
                        <TextBox Text="{Binding ExtraJvmArgs}" AcceptsReturn="False" />
                        <StackPanel Spacing="2" IsVisible="{Binding JsonVmArgs, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="hint" Text="{x:Static lang:UiText.LaunchSettings_JsonVmArgs}" />
                            <SelectableTextBlock Text="{Binding JsonVmArgs}" FontSize="12" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource Shell.TextMuted}" />
                        </StackPanel>

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.LaunchSettings_GameArgs}" />
                        <TextBox Text="{Binding ExtraGameArgs}" AcceptsReturn="False" />
                        <TextBlock Classes="hint" Text="{x:Static lang:UiText.LaunchSettings_ArgsHint}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}"
                        IsVisible="{Binding ZombieBuddy.IsShown}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_Section}" Classes="sectionTitle" />
                        <TextBlock Text="{Binding ZombieBuddy.ErrorText}" Classes="error" TextWrapping="Wrap"
                                   IsVisible="{Binding ZombieBuddy.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.ZombieBuddy_Status}" />
                        <Panel>
                            <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_StatusNotInitialized}"
                                       IsVisible="{Binding ZombieBuddy.State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ZombieBuddyState.NotInitialized}}" />
                            <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_StatusInitialized}"
                                       IsVisible="{Binding ZombieBuddy.State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ZombieBuddyState.Initialized}}" />
                            <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_StatusLeftovers}"
                                       IsVisible="{Binding ZombieBuddy.State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ZombieBuddyState.Leftovers}}" />
                        </Panel>

                        <StackPanel Spacing="8" IsVisible="{Binding ZombieBuddy.IsSubscribed}">
                            <TextBlock Classes="sectionLabel" Text="{x:Static lang:UiText.ZombieBuddy_Channel}" />
                            <TextBlock Text="{Binding ZombieBuddy.Source.Channel, Converter={x:Static loc:DisplayNames.ZombieBuddyChannelName}}"
                                       IsVisible="{Binding !ZombieBuddy.HasChannelChoice}" />
                            <StackPanel Orientation="Horizontal" Spacing="24" IsVisible="{Binding ZombieBuddy.HasChannelChoice}">
                                <RadioButton Content="{x:Static lang:UiText.ZombieBuddyChannel_Stable}"
                                             IsChecked="{Binding ZombieBuddy.SelectedChannel, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static zb:ZombieBuddyChannel.Stable}}" />
                                <RadioButton Content="{x:Static lang:UiText.ZombieBuddyChannel_Beta}"
                                             IsChecked="{Binding ZombieBuddy.SelectedChannel, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static zb:ZombieBuddyChannel.Beta}}" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{x:Static lang:UiText.ZombieBuddy_ChannelHint}" IsVisible="{Binding ZombieBuddy.HasChannelChoice}" />
                            <TextBlock Classes="hint" Text="{x:Static lang:UiText.ZombieBuddy_Source}" />
                            <SelectableTextBlock Text="{Binding ZombieBuddy.Source.Path}" FontSize="12" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource Shell.TextMuted}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Command="{Binding ZombieBuddy.InitializeCommand}" IsVisible="{Binding ZombieBuddy.IsSubscribed}">
                                <Panel>
                                    <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_Initialize}" IsVisible="{Binding !ZombieBuddy.IsInitialized}" />
                                    <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_Reinitialize}" IsVisible="{Binding ZombieBuddy.IsInitialized}" />
                                </Panel>
                            </Button>
                            <Button Content="{x:Static lang:UiText.ZombieBuddy_Remove}" Command="{Binding ZombieBuddy.RemoveCommand}"
                                    IsVisible="{Binding ZombieBuddy.CanOfferRemove}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{x:Static lang:UiText.ZombieBuddy_GameRunning}" IsVisible="{Binding ZombieBuddy.IsGameRunning}" />

                        <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_InstrumentWarning}" Classes="warning"
                                   TextWrapping="Wrap" IsVisible="{Binding ShowZombieBuddyInstrumentWarning}" />

                        <StackPanel Spacing="4" IsVisible="{Binding ZombieBuddy.IsInitialized}">
                            <ToggleSwitch Content="{x:Static lang:UiText.ZombieBuddy_AllowAll}" OnContent="{x:Null}" OffContent="{x:Null}"
                                          IsChecked="{Binding ZombieBuddy.IsAllowAll}" IsEnabled="{Binding ZombieBuddy.CanEdit}" />
                            <TextBlock Text="{x:Static lang:UiText.ZombieBuddy_AllowAllWarning}" Classes="warning"
                                       TextWrapping="Wrap" IsVisible="{Binding ZombieBuddy.IsAllowAll}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
