<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PzLauncher.Desktop.ViewModels"
        xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PzLauncher.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        Title="PzLauncher">

    <Design.DataContext>
        <!-- Previewer only; at runtime the DataContext comes from DI. -->
        <x:Static Member="design:DesignData.Main" />
    </Design.DataContext>

    <!-- The page view is picked by the DataTemplates in App.axaml. -->
    <ContentControl Content="{Binding CurrentPage}" />

</Window>
