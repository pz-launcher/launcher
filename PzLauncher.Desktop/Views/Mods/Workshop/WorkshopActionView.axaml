<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Mods.Workshop.Actions"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:controls="using:PzLauncher.Desktop.Views.Controls"
             xmlns:loc="using:PzLauncher.Desktop.Localization"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="520"
             x:Class="PzLauncher.Desktop.Views.Mods.Workshop.WorkshopActionView"
             x:DataType="vm:WorkshopActionViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.WorkshopAction" />
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="{x:Static lang:UiText.Workshop_ActionPlayingHint}" Classes="hint" TextWrapping="Wrap" />

        <ScrollViewer MaxHeight="320">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkshopActionItemRow">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                            <Panel Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,8,0">
                                <ic:FluentIcon Icon="Circle" IconVariant="Regular" FontSize="16" Foreground="{DynamicResource Shell.TextMuted}"
                                               IsVisible="{Binding State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:WorkshopActionItemState.Pending}}" />
                                <ic:FluentIcon Icon="ArrowSyncCircle" IconVariant="Regular" FontSize="16" Foreground="{DynamicResource Shell.Accent}"
                                               IsVisible="{Binding State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:WorkshopActionItemState.Running}}" />
                                <ic:FluentIcon Icon="CheckmarkCircle" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource Shell.Accent}"
                                               IsVisible="{Binding State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:WorkshopActionItemState.Done}}" />
                                <ic:FluentIcon Icon="DismissCircle" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource Shell.ErrorForeground}"
                                               IsVisible="{Binding State, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:WorkshopActionItemState.Failed}}" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Text="{Binding Failure, Converter={x:Static loc:DisplayNames.WorkshopItemFailureName}}" Classes="error"
                                           TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasFailure}" />
                                <TextBlock Text="{Binding SteamResult, StringFormat={x:Static lang:UiText.Workshop_SteamResultFormat}}" Classes="hint"
                                           FontSize="12" IsVisible="{Binding HasSteamResult}" />
                                <TextBlock Text="{x:Static lang:UiText.Workshop_StillOutdated}" Classes="warning"
                                           TextWrapping="Wrap" FontSize="12" IsVisible="{Binding IsStillOutdated}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat='{}{0}%'}" VerticalAlignment="Top" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Shell.TextMuted}"
                                       IsVisible="{Binding Percent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsWaitingForSteam}" />

        <TextBlock Text="{x:Static lang:UiText.Workshop_WaitingForEarlierAction}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding IsWaitingForEarlierAction}" />
        <TextBlock Text="{x:Static lang:UiText.Workshop_WaitingForSteam}" Classes="hint" IsVisible="{Binding ShowsWaitingForSteam}" />
        <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" IsVisible="{Binding IsFinished}" />
        <TextBlock Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{x:Static lang:UiText.Dialog_Cancel}" Command="{Binding CloseCommand}" IsVisible="{Binding !IsFinished}" />
            <Button Classes="accent" Content="{x:Static lang:UiText.Workshop_Close}" Command="{Binding CloseCommand}" IsVisible="{Binding IsFinished}" />
        </StackPanel>
    </StackPanel>
</UserControl>
