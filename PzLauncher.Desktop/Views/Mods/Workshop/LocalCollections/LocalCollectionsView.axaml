<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Mods.Workshop.LocalCollections"
             xmlns:workshopVm="using:PzLauncher.Desktop.ViewModels.Mods.Workshop"
             xmlns:local="using:PzLauncher.Desktop.Views.Mods.Workshop.LocalCollections"
             xmlns:workshop="using:PzLauncher.Desktop.Views.Mods.Workshop"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="560"
             x:Class="PzLauncher.Desktop.Views.Mods.Workshop.LocalCollections.LocalCollectionsView"
             x:DataType="vm:LocalCollectionsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.LocalCollections" />
    </Design.DataContext>

    <Grid ColumnDefinitions="260,16,*">
        <!-- The local collections. Rows are buttons, not ListBox items: a click shows the collection. -->
        <DockPanel Grid.Column="0">
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Command="{Binding NewCommand}" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Add" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static lang:UiText.ModCollections_New}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Panel>
                <TextBlock Text="{x:Static lang:UiText.LocalCollections_Empty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Shell.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocalCollectionRow">
                                <Button Theme="{StaticResource Shell.ListRow}" Classes.inUse="{Binding IsSelected}"
                                        Command="{Binding $parent[ItemsControl].((vm:LocalCollectionsViewModel)DataContext).SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat={x:Static lang:UiText.WorkshopCollections_ItemCountFormat}}" FontSize="12"
                                                   Foreground="{DynamicResource Shell.TextMuted}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>

        <!-- The selected collection. -->
        <Panel Grid.Column="2">
            <TextBlock Text="{x:Static lang:UiText.LocalCollections_NoSelection}" IsVisible="{Binding !HasSelection}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Shell.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

            <DockPanel IsVisible="{Binding HasSelection}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Selected.Name}" />
                    <TextBlock Text="{Binding Selected.ItemCount, StringFormat={x:Static lang:UiText.WorkshopCollections_ItemCountFormat}}"
                               Foreground="{DynamicResource Shell.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Command="{Binding AddItemsCommand}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="ClipboardPaste" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:UiText.LocalCollections_AddItems}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RenameCommand}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="Rename" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:UiText.ModCollections_Rename}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:UiText.ModCollections_Delete}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsAddingItems}" Margin="0,0,0,8" />

                <workshop:WorkshopSectionStatus DockPanel.Dock="Top" />
                <workshop:WorkshopItemListActions DockPanel.Dock="Top" />

                <Panel>
                    <workshop:WorkshopItemListView Rows="{Binding Rows}" Reorder="{Binding}" RowActionsWidth="176">
                        <workshop:WorkshopItemListView.RowActions>
                            <DataTemplate x:DataType="workshopVm:WorkshopItemRow">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Command="{Binding $parent[local:LocalCollectionsView].((vm:LocalCollectionsViewModel)DataContext).MoveToTopCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:UiText.ModCollections_MoveToTop}" AutomationProperties.Name="{x:Static lang:UiText.ModCollections_MoveToTop}">
                                        <ic:FluentIcon Icon="ChevronDoubleUp" IconVariant="Regular" FontSize="14" />
                                    </Button>
                                    <Button Command="{Binding $parent[local:LocalCollectionsView].((vm:LocalCollectionsViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:UiText.ModCollections_MoveUp}" AutomationProperties.Name="{x:Static lang:UiText.ModCollections_MoveUp}">
                                        <ic:FluentIcon Icon="ArrowUp" IconVariant="Regular" FontSize="14" />
                                    </Button>
                                    <Button Command="{Binding $parent[local:LocalCollectionsView].((vm:LocalCollectionsViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:UiText.ModCollections_MoveDown}" AutomationProperties.Name="{x:Static lang:UiText.ModCollections_MoveDown}">
                                        <ic:FluentIcon Icon="ArrowDown" IconVariant="Regular" FontSize="14" />
                                    </Button>
                                    <Button Command="{Binding $parent[local:LocalCollectionsView].((vm:LocalCollectionsViewModel)DataContext).MoveToBottomCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:UiText.ModCollections_MoveToBottom}" AutomationProperties.Name="{x:Static lang:UiText.ModCollections_MoveToBottom}">
                                        <ic:FluentIcon Icon="ChevronDoubleDown" IconVariant="Regular" FontSize="14" />
                                    </Button>
                                    <Button Command="{Binding $parent[local:LocalCollectionsView].((vm:LocalCollectionsViewModel)DataContext).RemoveItemCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:UiText.LocalCollections_RemoveItem}" AutomationProperties.Name="{x:Static lang:UiText.LocalCollections_RemoveItem}">
                                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </workshop:WorkshopItemListView.RowActions>
                    </workshop:WorkshopItemListView>
                    <TextBlock Text="{x:Static lang:UiText.LocalCollections_ItemsEmpty}" IsVisible="{Binding IsListEmpty}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Shell.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Panel>
            </DockPanel>
        </Panel>
    </Grid>
</UserControl>
