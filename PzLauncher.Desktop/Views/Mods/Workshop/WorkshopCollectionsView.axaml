<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Mods.Workshop"
             xmlns:local="using:PzLauncher.Desktop.Views.Mods.Workshop"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             x:Class="PzLauncher.Desktop.Views.Mods.Workshop.WorkshopCollectionsView"
             x:DataType="vm:WorkshopCollectionsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignData.WorkshopCollections" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Shell.TextMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="UserCollectionRowTemplate" x:DataType="vm:WorkshopUserCollectionRow">
            <Button Theme="{StaticResource Shell.ListRow}" Classes.inUse="{Binding IsOpen}"
                    Command="{Binding $parent[ItemsControl].((vm:WorkshopCollectionsViewModel)DataContext).OpenUserCollectionCommand}"
                    CommandParameter="{Binding}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Text="{Binding ChildCount, StringFormat={x:Static lang:UiText.WorkshopCollections_ItemCountFormat}}"
                               FontSize="12" Foreground="{DynamicResource Shell.TextMuted}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="260,16,*">
        <!-- Open by link, or pick a collection opened before. -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding LinkText}" PlaceholderText="{x:Static lang:UiText.WorkshopCollections_LinkPlaceholder}"
                             Margin="0,0,6,0">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding OpenCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="accent" Content="{x:Static lang:UiText.WorkshopCollections_Open}" Command="{Binding OpenCommand}" />
                </Grid>
                <TextBlock Text="{Binding LinkErrorText}" Classes="error" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding LinkErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- The Steam account's collections, then the ones opened here. Rows are buttons, not ListBox items: a click opens the collection. -->
            <ScrollViewer>
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.WorkshopCollections_Favorited}" Classes="sectionTitle" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding RefreshUserCollectionsCommand}"
                                ToolTip.Tip="{x:Static lang:UiText.WorkshopCollections_RefreshHint}" ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static lang:UiText.Mods_Refresh}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetchingUserCollections}" />
                    <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_FavoritedEmpty}" IsVisible="{Binding IsFavoritedEmpty}" Classes="hint" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Favorited}" ItemTemplate="{StaticResource UserCollectionRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_Published}" Classes="sectionTitle" Margin="0,12,0,4" />
                    <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_PublishedEmpty}" IsVisible="{Binding IsPublishedEmpty}" Classes="hint" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Published}" ItemTemplate="{StaticResource UserCollectionRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="{Binding UserCollectionsErrorText}" Classes="warning" TextWrapping="Wrap" Margin="0,4,0,0"
                               IsVisible="{Binding UserCollectionsErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding UserCollectionsUpdatedText}" Classes="hint" TextWrapping="Wrap"
                               IsVisible="{Binding UserCollectionsUpdatedText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_Remembered}" Classes="sectionTitle" Margin="0,12,0,4" />
                    <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_RememberedEmpty}" IsVisible="{Binding !HasRemembered}" Classes="hint" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Remembered}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RememberedWorkshopCollectionRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Theme="{StaticResource Shell.ListRow}" Classes.inUse="{Binding IsOpen}"
                                            Command="{Binding $parent[ItemsControl].((vm:WorkshopCollectionsViewModel)DataContext).OpenRememberedCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Text="{Binding IdText}" FontSize="12" Foreground="{DynamicResource Shell.TextMuted}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Command="{Binding $parent[ItemsControl].((vm:WorkshopCollectionsViewModel)DataContext).ForgetCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:UiText.WorkshopCollections_Forget}"
                                            AutomationProperties.Name="{x:Static lang:UiText.WorkshopCollections_Forget}">
                                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- The open collection. -->
        <DockPanel Grid.Column="2">
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="warning" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Panel>
                <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_NoneOpen}" IsVisible="{Binding !HasCollection}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Shell.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                <DockPanel IsVisible="{Binding HasCollection}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Title}" />
                        <TextBlock Text="{Binding IdText}" Foreground="{DynamicResource Shell.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ItemCount, StringFormat={x:Static lang:UiText.WorkshopCollections_ItemCountFormat}}"
                                   Foreground="{DynamicResource Shell.TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Command="{Binding SubscribeMissingCommand}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Add" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_SubscribeMissing}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MissingCount, StringFormat='({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding UpdateOutdatedCommand}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="ArrowDownload" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static lang:UiText.Workshop_UpdateAll}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OutdatedCount, StringFormat='({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GenerateCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="{x:Static lang:UiText.WorkshopCollections_GenerateHint}" ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Collections" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_Generate}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenCollectionInSteamCommand}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Globe" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static lang:UiText.Workshop_OpenInSteam}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding UnsubscribeAllCommand}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_UnsubscribeAll}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Classes="hint" TextWrapping="Wrap"
                               IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,110,1.5*,80,120,1.5*,40" Margin="13,0,13,4">
                        <TextBlock Grid.Column="0" Classes="columnHeader" Text="{x:Static lang:UiText.Workshop_ColumnTitle}" />
                        <TextBlock Grid.Column="1" Classes="columnHeader" Text="{x:Static lang:UiText.Workshop_ColumnItemId}" />
                        <TextBlock Grid.Column="2" Classes="columnHeader" Text="{x:Static lang:UiText.Workshop_ColumnMods}" />
                        <TextBlock Grid.Column="3" Classes="columnHeader" Text="{x:Static lang:UiText.Workshop_ColumnSize}" />
                        <TextBlock Grid.Column="4" Classes="columnHeader" Text="{x:Static lang:UiText.Workshop_ColumnState}" />
                        <TextBlock Grid.Column="5" Classes="columnHeader" Text="{x:Static lang:UiText.Mods_ColumnCollections}" />
                    </Grid>

                    <Panel>
                        <TextBlock Text="{x:Static lang:UiText.WorkshopCollections_Empty}" IsVisible="{Binding IsCollectionEmpty}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Shell.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopItemRow">
                                        <Border Padding="12,6" Margin="0,0,0,4" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
                                            <Grid ColumnDefinitions="2*,110,1.5*,80,120,1.5*,40">
                                                <TextBlock Grid.Column="0" Classes="cell" Text="{Binding Title}" FontWeight="SemiBold" ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding IdText}" Foreground="{DynamicResource Shell.TextMuted}" />
                                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding ModIds}" ToolTip.Tip="{Binding ModIds}" />
                                                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding SizeMb, StringFormat={x:Static lang:UiText.Workshop_SizeFormat}}"
                                                           Foreground="{DynamicResource Shell.TextMuted}"
                                                           IsVisible="{Binding SizeMb, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <local:WorkshopItemStateCell Grid.Column="4" />
                                                <TextBlock Grid.Column="5" Classes="cell" Text="{Binding CollectionNames}" ToolTip.Tip="{Binding CollectionNames}" />
                                                <Button Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].((vm:WorkshopCollectionsViewModel)DataContext).OpenInSteamCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{x:Static lang:UiText.Workshop_OpenInSteam}" AutomationProperties.Name="{x:Static lang:UiText.Workshop_OpenInSteam}">
                                                    <ic:FluentIcon Icon="Globe" IconVariant="Regular" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </DockPanel>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
