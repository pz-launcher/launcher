<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PzLauncher.Desktop.ViewModels.Mods"
             xmlns:design="using:PzLauncher.Desktop.ViewModels.Design"
             xmlns:controls="using:PzLauncher.Desktop.Views.Controls"
             xmlns:lang="using:PzLauncher.Desktop.Lang"
             xmlns:mods="using:PzLauncher.Desktop.Views.Mods"
             xmlns:modpacks="using:PzLauncher.Desktop.Views.Mods.Modpacks"
             xmlns:workshop="using:PzLauncher.Desktop.Views.Mods.Workshop"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="PzLauncher.Desktop.Views.Mods.ModsView"
             x:DataType="vm:ModsViewModel"
             controls:PageActivation.Command="{Binding ActivateCommand}">

    <Design.DataContext>
        <x:Static Member="design:DesignData.Mods" />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="sidebar left" MinWidth="180">
            <StackPanel Margin="8" Spacing="2">
                <TextBlock Classes="sidebarHeader" Text="{x:Static lang:UiText.Shell_NavMods}" />
                <controls:NavItem Icon="PuzzlePiece" Content="{x:Static lang:UiText.Mods_SectionMods}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Mods}}" />
                <controls:NavItem Icon="Collections" Content="{x:Static lang:UiText.Mods_SectionCollections}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Collections}}" />
                <controls:NavItem Icon="BoxMultiple" Content="{x:Static lang:UiText.Mods_SectionModpacks}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Modpacks}}" />
                <controls:NavItem Icon="CloudArrowDown" Content="{x:Static lang:UiText.Mods_SectionWorkshopSubscriptions}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopSubscriptions}}" />
                <controls:NavItem Icon="Library" Content="{x:Static lang:UiText.Mods_SectionWorkshopCollections}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopCollections}}" />
                <controls:NavItem Icon="AppsList" Content="{x:Static lang:UiText.Mods_SectionLocalCollections}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.LocalCollections}}" />
                <controls:NavItem Icon="Star" Content="{x:Static lang:UiText.Mods_SectionWorkshopFavorites}"
                                  IsChecked="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopFavorites}}" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1" Background="{DynamicResource Shell.ContentBackground}">
            <DockPanel Margin="16">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionMods}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Mods}}" />
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionCollections}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Collections}}" />
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionModpacks}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Modpacks}}" />
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionWorkshopSubscriptions}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopSubscriptions}}" />
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionWorkshopCollections}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopCollections}}" />
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionLocalCollections}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.LocalCollections}}" />
                    <TextBlock Grid.Column="0" Text="{x:Static lang:UiText.Mods_SectionWorkshopFavorites}" Classes="pageTitle" VerticalAlignment="Center"
                               IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopFavorites}}" />
                    <Button Grid.Column="1" Content="{x:Static lang:UiText.Mods_Refresh}" Command="{Binding RefreshCommand}" />
                </Grid>

                <!-- The Workshop sections show their own load state. -->
                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding ShowsGameFiles}">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                               IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static lang:UiText.Mods_GameRunning}" Classes="warning"
                           TextWrapping="Wrap" IsVisible="{Binding IsGameRunning}" Margin="0,0,0,8" />

                <Panel>
                    <TextBlock Text="{x:Static lang:UiText.Mods_NoGameInstall}" IsVisible="{Binding HasNoGameInstall}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Shell.TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                    <!-- Wrapped: each section view's own DataContext is its section view model, so it can't bind Section itself. -->
                    <Panel IsVisible="{Binding !HasNoGameInstall}">
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Mods}}">
                            <mods:InstalledModsView DataContext="{Binding Mods}" />
                        </Panel>
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Collections}}">
                            <mods:ModCollectionsView DataContext="{Binding Collections}" />
                        </Panel>
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.Modpacks}}">
                            <modpacks:ModpacksView DataContext="{Binding Modpacks}" />
                        </Panel>
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopSubscriptions}}">
                            <workshop:WorkshopSubscriptionsView DataContext="{Binding WorkshopSubscriptions}" />
                        </Panel>
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopCollections}}">
                            <workshop:WorkshopCollectionsView DataContext="{Binding WorkshopCollections}" />
                        </Panel>
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.LocalCollections}}">
                            <workshop:LocalCollectionsView DataContext="{Binding LocalCollections}" />
                        </Panel>
                        <Panel IsVisible="{Binding Section, Converter={x:Static controls:EnumMatchConverter.Instance}, ConverterParameter={x:Static vm:ModsSection.WorkshopFavorites}}">
                            <workshop:WorkshopFavoritesView DataContext="{Binding WorkshopFavorites}" />
                        </Panel>
                    </Panel>
                </Panel>
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
