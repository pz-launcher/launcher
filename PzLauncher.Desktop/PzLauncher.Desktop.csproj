<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <IsAotCompatible>true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- LibraryImport-generated marshalling code (WindowsDpapiSecretProtector). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- A binding without x:DataType in scope fails the build. -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>PzLauncher</AssemblyName>
        <RootNamespace>PzLauncher.Desktop</RootNamespace>
        <NeutralLanguage>en</NeutralLanguage>
        <!-- Local builds are development builds that never update themselves; release.yml passes -p:Version from the tag. -->
        <Version>0.0.0-dev</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <!-- Public so {x:Static} can reach it; generated into obj/ so it stays out of git and works without an IDE. -->
    <ItemGroup>
        <EmbeddedResource Update="Lang\UiText.resx">
            <Generator>MSBuild:Compile</Generator>
            <StronglyTypedFileName>$(IntermediateOutputPath)UiText.Designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>PzLauncher.Desktop.Lang</StronglyTypedNamespace>
            <StronglyTypedClassName>UiText</StronglyTypedClassName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PzLauncher.Core\PzLauncher.Core.csproj" />
    </ItemGroup>
</Project>
