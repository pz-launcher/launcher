root = true

[*.cs]
# Every project treats warnings as errors, so "warning" below already fails the build.

# Switch exhaustiveness: a missing enum case fails the build; enums cross boundaries by name only, so unnamed values never arrive.
dotnet_diagnostic.CS8509.severity = error
dotnet_diagnostic.CS8524.severity = none

# Async
dotnet_diagnostic.CA1068.severity = warning
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.CA2012.severity = warning
dotnet_diagnostic.CA2016.severity = warning

# Exceptions: no blanket catch (the desktop global handlers don't catch, they handle events)
dotnet_diagnostic.CA1031.severity = warning

# API correctness
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA2208.severity = warning

# Types
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.CA2211.severity = warning

# Logging
dotnet_diagnostic.CA2254.severity = warning

# Code quality (IDE and dotnet format only: EnforceCodeStyleInBuild is off)
# Suggestion only: dotnet format can't see the resx-generated UiText and would delete `using PzLauncher.Desktop.Lang`.
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0290.severity = warning

# Namespaces: file-scoped, matching the folder path
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning

# Naming: _camelCase private fields; PascalCase static readonly fields and constants
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = *
dotnet_naming_symbols.const_fields.required_modifiers = const
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_rule.const_pascal.symbols = const_fields
dotnet_naming_rule.const_pascal.style = pascal
dotnet_naming_rule.const_pascal.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

# Modern C# style
dotnet_diagnostic.IDE0250.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion

[PzLauncher.Core/**.cs]
dotnet_diagnostic.CA2007.severity = warning

# Banned APIs (BannedSymbols.txt): off by default (.globalconfig), opted in per path; the OS seam stays exempt
[PzLauncher.Core/**.cs]
dotnet_diagnostic.RS0030.severity = warning

[PzLauncher.Core/Platform/**.cs]
dotnet_diagnostic.RS0030.severity = none

[PzLauncher.Desktop/ViewModels/**.cs]
dotnet_diagnostic.RS0030.severity = warning

[PzLauncher.Desktop/ViewModels/Design/**.cs]
dotnet_diagnostic.RS0030.severity = none

[{PzLauncher.Core.Tests,PzLauncher.Desktop.Tests}/**.cs]
dotnet_diagnostic.RS0030.severity = warning
